<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D38BDF8">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#182B4D"
                        android:endColor="#0E1B33" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1.2dp"
                        android:color="#4D38BDF8" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>