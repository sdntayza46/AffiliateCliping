<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Body with subtle specular gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#15223A"
                android:centerColor="#0F1829"
                android:endColor="#0B1220" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Liquid Glass Specular Rim / Hairline Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.2dp"
                android:color="#2B4068" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>