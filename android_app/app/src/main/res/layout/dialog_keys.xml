<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kelola API Key Groq"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="1 Key untuk Transkripsi Suara (Whisper) &amp; Kurasi Klip AI"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- SAVED KEYS LIST SECTION -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/tvSavedKeysHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="API Key Groq Tersimpan:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearProviderKeys"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="4dp"
            android:paddingVertical="0dp"
            android:text="Hapus Semua"
            android:textColor="@color/accent_red"
            android:textSize="10sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/input_bg"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/layoutSavedKeysList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNoKeys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="Belum ada key tersimpan untuk provider ini."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- INPUT NEW KEYS -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tambah Key Baru:"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etKeyInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="Tempel API key Groq (gsk_...)"
            android:paddingHorizontal="10dp"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSaveKeys"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/white"
            android:text="+ Simpan"
            android:textColor="@color/black"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActiveKeyCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Key Aktif: 0 Groq"
        android:textColor="@color/accent_emerald"
        android:textSize="10sp" />

    <!-- BOTTOM ACTIONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResetKeys"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reset Exhausted"
            android:textColor="@color/accent_amber"
            android:textSize="10sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCancelKeys"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Tutup"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
