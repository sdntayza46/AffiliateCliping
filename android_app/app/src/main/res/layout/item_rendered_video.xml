<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="16dp"
    android:animateLayoutChanges="true">

    <!-- HEADER: PART BADGE, FILE NAME, SIZE & DURATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVideoPartBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_active"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Part 1"
            android:textColor="@color/brand_blue_light"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="AutoClip_Part1_20261024_1080p.mp4"
                android:textColor="@color/text_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="📁 14.5 MB  •  ⏱ 00:48 (48 detik)"
                android:textColor="@color/accent_emerald_glow"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ACTION BUTTONS: PUTAR & BAGIKAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnItemPlay"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/button_gradient_primary"
            app:backgroundTint="@null"
            android:text="▶ PUTAR VIDEO"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnItemShare"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/button_liquid_glass"
            app:backgroundTint="@null"
            android:text="↗ BAGIKAN"
            android:textColor="@color/brand_blue_light"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="#2038BDF8" />

    <!-- COLLAPSIBLE CAPTION TOGGLE HEADER -->
    <LinearLayout
        android:id="@+id/btnToggleCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvCaptionChevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="@color/brand_blue_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCaptionToggleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="📝 Caption &amp; Hashtag TikTok (Ketuk untuk sembunyikan)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- EXPANDABLE CAPTION CONTENT -->
    <LinearLayout
        android:id="@+id/layoutCaptionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:animateLayoutChanges="true">

        <EditText
            android:id="@+id/etItemCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:background="@drawable/input_bg"
            android:gravity="top|start"
            android:hint="Caption TikTok untuk video ini..."
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnItemCopyCaption"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_liquid_glass"
            app:backgroundTint="@null"
            android:text="📋 SALIN CAPTION INI"
            android:textColor="@color/brand_blue_light"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />
    </LinearLayout>

</LinearLayout>